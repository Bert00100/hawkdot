# Copie para .env e substitua os marcadores antes de iniciar a aplicação.
# Setup completo: docs/ambiente-local.md. Nunca versione o .env real.
# Use as senhas dos logins criados no Postgres; caracteres especiais na
# senha precisam de percent-encoding na URL (por exemplo, @ vira %40).

# API: login restrito que herda hawkdot_app; nunca use adm aqui.
DATABASE_URL=postgresql://hawkdot_api_login:SENHA_API@localhost:5432/hawkdot

# Worker: necessário para npm run worker; login que herda hawkdot_worker.
DATABASE_URL_WORKER=postgresql://hawkdot_worker_login:SENHA_WORKER@localhost:5432/hawkdot

# Testes: banco exclusivo e descartável. A preparação apaga seus dados.
# adm é usado somente para preparar/limpar dados de teste.
DATABASE_URL_TEST=postgresql://hawkdot_api_login:SENHA_API@localhost:5432/hawkdot_test
DATABASE_URL_TEST_ADMIN=postgresql://adm:SENHA_ADMIN_CODIFICADA@localhost:5432/hawkdot_test
DATABASE_URL_WORKER_TEST=postgresql://hawkdot_worker_login:SENHA_WORKER@localhost:5432/hawkdot_test

# Gere DOIS valores independentes com o comando abaixo, um para cada segredo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET: mínimo de 32 caracteres. TTL em segundos (padrão: 1 hora).
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
JWT_TTL_SECONDS=3600

# Obrigatória: exatamente 64 caracteres hexadecimais (32 bytes).
# Preserve esta chave: credenciais salvas dependem dela para serem decifradas.
CREDENTIAL_ENCRYPTION_KEY=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS

# Opcional: .next (padrão), .next-e2e ou .next-build.
# NEXT_DIST_DIR=.next

# NODE_ENV é definido pelo framework/comando; PATH é herdado do sistema.
# Não fixe essas variáveis aqui.
